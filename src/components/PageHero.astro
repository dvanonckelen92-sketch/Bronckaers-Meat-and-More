---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  image: string;
  position?: string;
  // Foto die volledig naast de titel staat, zonder bijsnijden.
  photo?: { src: string; srcset?: string; width: number; height: number; alt: string };
}

const { eyebrow, title, lead, image, position = "center", photo } = Astro.props;
---

<section class="page-hero">
  <div class="page-hero-bg" role="img" aria-label="" style={`background-image: url('${image}'); background-position: ${position}`}>
    <div class="page-hero-overlay"></div>
  </div>

  <div class:list={["container page-hero-inner", { "has-photo": photo }]}>
  <div class="page-hero-content">
    <p class="eyebrow eyebrow-light" data-reveal>{eyebrow}</p>
    <h1 data-reveal style="--reveal-delay: 90ms">{title}</h1>
    {lead && (
      <p class="page-hero-lead" data-reveal style="--reveal-delay: 180ms">
        {lead}
      </p>
    )}
  </div>
  {photo && (
    <figure class="page-hero-photo" data-reveal style="--reveal-delay: 120ms">
      <img
        src={photo.src}
        srcset={photo.srcset}
        sizes={photo.srcset ? "(max-width: 860px) 80vw, 420px" : undefined}
        width={photo.width}
        height={photo.height}
        alt={photo.alt}
        fetchpriority="high"
      />
    </figure>
  )}
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 42vh;
    color: var(--color-cream);
    overflow: hidden;
  }

  .page-hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  @media (min-width: 900px) {
    .page-hero-bg {
      background-attachment: fixed;
    }
  }

  .page-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      rgba(23, 15, 13, 0.94) 0%,
      rgba(23, 15, 13, 0.8) 45%,
      rgba(164, 98, 47, 0.5) 100%
    );
  }

  .page-hero-inner {
    position: relative;
    z-index: 1;
  }

  .page-hero-inner.has-photo {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    padding-top: 2.5rem;
    padding-bottom: 2.5rem;
  }

  .page-hero-photo {
    margin: 0;
  }

  .page-hero-photo img {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: min(420px, 52vh);
    margin-left: auto;
    border-radius: var(--radius);
    border: 6px solid rgba(246, 240, 230, 0.9);
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.45);
  }

  @media (max-width: 860px) {
    .page-hero-inner.has-photo {
      grid-template-columns: 1fr;
    }
    .page-hero-photo img {
      margin-left: 0;
      max-height: 380px;
    }
  }

  .page-hero-content {
    max-width: 640px;
    padding-top: 3.5rem;
    padding-bottom: 3.5rem;
  }

  .eyebrow-light {
    color: var(--color-gold-light);
    margin-bottom: 1.25rem;
  }

  .page-hero h1 {
    font-size: clamp(2.2rem, 4.5vw, 3.2rem);
    color: var(--color-white);
  }

  .page-hero-lead {
    margin-top: 1.25rem;
    color: var(--color-cream-soft);
    max-width: 52ch;
  }
</style>
