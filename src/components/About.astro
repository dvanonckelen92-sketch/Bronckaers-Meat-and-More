---
import HeritageSeal from "./HeritageSeal.astro";

interface Props {
  variant?: "home" | "full";
}

const { variant = "full" } = Astro.props;

const milestones = [
  { year: "1962", text: "Georges Bronckaers opent een buurtslagerij in Gingelom." },
  { year: "Jaren '90", text: "Zoon Frank neemt de zaak over en breidt het traiteuraanbod uit." },
  { year: "2024", text: "Kleinzoon Aaron, de derde generatie, opent de volledig vernieuwde zaak." },
];
---

<section id="over-ons" class="about">
  <div class="container about-grid">
    <div class="about-images" data-reveal>
      <img
        class="img-main"
        src="/images/drie-generaties-bronckaers-640.webp"
        srcset="/images/drie-generaties-bronckaers-640.webp 640w, /images/drie-generaties-bronckaers-1000.webp 1000w"
        sizes="(max-width: 900px) 100vw, 520px"
        width="640"
        height="480"
        alt="Drie generaties Bronckaers, Georges, Frank en Aaron, lachend arm in arm"
        loading="lazy"
      />
      {variant === "full" && (
        <div class="about-seal">
          <HeritageSeal size={110} />
        </div>
      )}
    </div>

    <div class="about-content">
      <p class="eyebrow" data-reveal>Ons verhaal</p>
      <h2 data-reveal style="--reveal-delay: 80ms">Familiebedrijf, van generatie op generatie</h2>
      <p class="about-text" data-reveal style="--reveal-delay: 160ms">
        Sinds 1962 staat de naam Bronckaers in Gingelom voor eerlijk vlees.
        Wat begon als een kleine buurtslagerij van Georges Bronckaers, groeide
        via zijn zoon Frank uit tot een begrip in de streek. Vandaag zet Aaron,
        de derde generatie, de traditie verder in een volledig vernieuwde zaak,
        met een groter assortiment (slagerij, traiteur en bakkerij) en
        dezelfde zorg voor kwaliteit en versheid.
      </p>
      {variant === "full" && (
        <p class="about-text" data-reveal style="--reveal-delay: 240ms">
          Wij kiezen bewust voor korte ketens, vakmanschap boven snelheid, en
          persoonlijk contact met elke klant. Meat &amp; More staat voor meer
          dan vlees alleen: ontdek ook ons versgebakken brood, traiteuraanbod,
          huisbereide schotels en catering op maat.
        </p>
      )}

      {variant === "full" ? (
        <>
          <ul class="milestones" data-reveal style="--reveal-delay: 320ms">
            {milestones.map((m) => (
              <li>
                <span class="year">{m.year}</span>
                <span class="text">{m.text}</span>
              </li>
            ))}
          </ul>
          <figure class="renovation" data-reveal style="--reveal-delay: 400ms">
            <img
              src="/images/winkel-verbouwing-640.webp"
              srcset="/images/winkel-verbouwing-640.webp 640w, /images/winkel-verbouwing-1000.webp 1000w"
              sizes="(max-width: 900px) 100vw, 560px"
              width="640"
              height="480"
              alt="Onze winkel tijdens de verbouwing, met kale muren, ladders en kruiwagens onder het afdak"
              loading="lazy"
            />
            <figcaption>De winkel tijdens de verbouwing, voor de heropening.</figcaption>
          </figure>
        </>
      ) : (
        <a href="/over-ons/" class="btn btn-primary about-cta" data-reveal style="--reveal-delay: 320ms">
          Ontdek ons volledig verhaal
        </a>
      )}
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }

  .about-images {
    position: relative;
  }

  .img-main {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    box-shadow: 0 20px 40px rgba(28, 23, 20, 0.25);
  }

  .about-seal {
    position: absolute;
    top: -1.5rem;
    left: -1.5rem;
    z-index: 2;
    filter: drop-shadow(0 8px 16px rgba(23, 15, 13, 0.35));
  }

  .about-text {
    color: var(--color-charcoal-soft);
    margin-top: 1.25rem;
    max-width: 55ch;
  }

  h2 {
    margin-top: 0.6rem;
    font-size: clamp(1.9rem, 3.5vw, 2.6rem);
    max-width: 14ch;
  }

  .milestones {
    list-style: none;
    padding: 0;
    margin: 2.5rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border-top: 1px solid rgba(28, 23, 20, 0.12);
    padding-top: 1.75rem;
  }

  .milestones li {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 1rem;
    align-items: baseline;
  }

  .year {
    font-family: var(--font-display);
    color: var(--color-copper);
    font-weight: 600;
  }

  .text {
    color: var(--color-charcoal-soft);
    font-size: 0.95rem;
  }

  .renovation {
    margin: 2rem 0 0;
    max-width: 560px;
  }

  .renovation img {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
  }

  .renovation figcaption {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-charcoal-soft);
  }

  .about-cta {
    margin-top: 2rem;
    display: inline-flex;
  }

  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
    .about-images {
      margin-bottom: 1rem;
    }
    .about-seal {
      display: none;
    }
  }
</style>
