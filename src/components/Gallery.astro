---
import SocialLinks from "./SocialLinks.astro";

const photos = [
  { src: "/images/winkel-toog-overzicht-1000.webp", alt: "De vernieuwde winkel met de lange toog vol vers vlees, vleeswaren en salades" },
  { src: "/images/team-achter-toog-1000.webp", alt: "Twee medewerkers achter de toog met vers vlees, worsten en gemarineerde spiesen" },
  { src: "/images/hamvormen-kookkast-640.webp", alt: "Hamvormen in de kookkast van ons atelier" },
  { src: "/images/hamburgers-handgeperst-640.webp", alt: "Verse hamburgers die met de hand geperst worden in het atelier van Bronckaers" },
  { src: "/images/huisgemaakte-burgers-toog-640.webp", alt: "Schalen met huisgemaakte burgers op de toog: gepaneerd, met spek omwikkeld, met een schijf rode ui en met een kruidenrand" },
  { src: "/images/salade-mengen-atelier-640.webp", alt: "In het atelier wordt een salade met de hand gemengd in een grote kom" },
  { src: "/images/boulettes-huisgemaakt-640.webp", alt: "Bakplaten vol huisgemaakte boulettes uit ons atelier" },
  { src: "/images/team-traiteur-keuken-640.webp", alt: "Medewerkers vullen in het atelier bakjes met puree en saus voor de traiteurtoog" },
  { src: "/images/gemarineerd-vlees-toog-640.webp", alt: "Schalen met gemarineerde reepjes kip en vlees met paprika en ui in de toog" },
  { src: "/images/vleeswaren-snijden-snijmachine-640.webp", alt: "Een medewerker snijdt vleeswaren aan de snijmachine" },
  { src: "/images/team-kaas-snijden-640.webp", alt: "Een medewerker snijdt kaas aan de snijmachine in de winkel" },
  { src: "/images/klant-bediend-kassa-640.webp", alt: "Een klant krijgt de boodschappen in een Bronckaers-tas aangereikt aan de kassa" },
  { src: "/images/team-puree-portioneren-480.webp", alt: "Aaron, de derde generatie, spuit aardappelpuree in een bakje in het atelier" },
  { src: "/images/penne-kip-huisgemaakte-saus-640.webp", alt: "Huisgemaakte saus wordt over penne met kip geschept" },
  { src: "/images/taartentoog-patisserie-1000.webp", alt: "Toog vol taarten, rijsttaartjes en gebak, met rekken brood en koffiekoeken erachter" },
  { src: "/images/steengrillschotel-bovenaanzicht-800.webp", alt: "Steengrillschotel met koteletten, biefstuk, kip, worstjes, gepaneerde stukjes, paprikaspiesjes en kaas" },
];
---

<section id="sfeer" class="gallery">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">Sfeer &amp; vakmanschap</p>
      <h2>Een kijkje in de winkel en achter de schermen</h2>
    </div>

    <div class="gallery-grid">
      {photos.map(({ src, alt }, i) => (
        <div class="gallery-item" data-reveal style={`--reveal-delay: ${(i % 3) * 90}ms`}>
          <img src={src} alt={alt} loading="lazy" />
        </div>
      ))}
    </div>

    <div class="gallery-follow">
      <p class="gallery-note">Meer foto's en het laatste nieuws:</p>
      <SocialLinks variant="light" />
    </div>
  </div>
</section>

<style>
  .gallery {
    background: var(--color-white);
  }

  .section-head {
    max-width: 640px;
    margin: 0 auto 3rem;
    text-align: center;
  }

  .section-head h2 {
    margin-top: 0.75rem;
    font-size: clamp(1.9rem, 3.5vw, 2.5rem);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-auto-rows: 140px;
    gap: 0.75rem;
  }

  .gallery-item:nth-child(1) {
    grid-column: span 3;
    grid-row: span 2;
  }
  .gallery-item:nth-child(2) {
    grid-column: span 3;
    grid-row: span 2;
  }
  .gallery-item:nth-child(n + 3) {
    grid-column: span 3;
    grid-row: span 2;
  }

  @media (min-width: 700px) {
    .gallery-item:nth-child(n + 3) {
      grid-column: span 2;
    }
    /* 16 foto's: twee grote bovenaan, rijen van drie, twee grote onderaan */
    .gallery-item:nth-last-child(-n + 2) {
      grid-column: span 3;
    }
  }

  .gallery-item {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
  }

  .gallery-item::after {
    content: "";
    position: absolute;
    inset: 0;
    border: 2px solid var(--color-gold);
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
  }

  .gallery-item:hover::after {
    opacity: 1;
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), filter 0.4s ease;
    filter: saturate(0.94);
  }

  .gallery-item:hover img {
    transform: scale(1.08);
    filter: saturate(1.08);
  }

  .gallery-follow {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .gallery-note {
    font-size: 0.85rem;
    color: var(--color-charcoal-soft);
  }

  @media (max-width: 700px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 160px;
    }
    .gallery-item,
    .gallery-item:nth-child(1),
    .gallery-item:nth-child(2) {
      grid-column: span 1 !important;
      grid-row: span 1 !important;
    }
  }
</style>
