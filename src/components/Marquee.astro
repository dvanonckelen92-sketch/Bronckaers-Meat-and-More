---
const items = [
  "SINDS 1962",
  "SLAGERIJ & BAKKERIJ",
  "ALLES ZELF GEMAAKT",
  "DRIE GENERATIES BRONCKAERS",
  "VERS ELKE DAG",
  "TRAITEUR & CATERING OP MAAT",
];
---

<div class="marquee" role="presentation" aria-hidden="true">
  <div class="marquee-track">
    {[...items, ...items].map((item) => (
      <span class="marquee-item">
        {item}
        <span class="marquee-dot">&#9670;</span>
      </span>
    ))}
  </div>
</div>

<style>
  .marquee {
    background: var(--color-charcoal);
    border-top: 1px solid rgba(201, 161, 90, 0.2);
    border-bottom: 1px solid rgba(201, 161, 90, 0.2);
    overflow: hidden;
    padding: 1.1rem 0;
  }

  .marquee-item {
    display: inline-flex;
    align-items: center;
    gap: 1.5rem;
    padding: 0 1.5rem;
    font-family: var(--font-display);
    font-size: 0.95rem;
    letter-spacing: 0.08em;
    color: var(--color-gold-light);
    white-space: nowrap;
  }

  .marquee-dot {
    font-size: 0.5rem;
    color: var(--color-copper);
  }
</style>
