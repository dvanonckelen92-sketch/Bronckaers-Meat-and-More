---
const categories = [
  {
    title: "Ambachtelijke slagerij",
    img: "https://images.unsplash.com/photo-1625604086988-6e41981275fa?auto=format&fit=crop&w=900&q=80",
  },
  {
    title: "Bakkerij",
    img: "/images/bakkerij-wiame.jpg",
    pos: "center 38%",
  },
  {
    title: "Traiteur &amp; huisbereid",
    img: "https://images.unsplash.com/photo-1689860892307-7db54ab276ba?auto=format&fit=crop&w=800&q=80",
  },
  {
    title: "Gerookte specialiteiten",
    img: "/images/gerookte-specialiteiten.webp",
  },
  {
    title: "Gevogelte &amp; wild",
    img: "https://images.unsplash.com/photo-1759568558640-3c9239a6153e?auto=format&fit=crop&w=800&q=80",
  },
  {
    title: "Feest &amp; catering",
    img: "https://images.unsplash.com/photo-1555244162-803834f70033?auto=format&fit=crop&w=800&q=80",
  },
];
---

<section id="onze-selectie" class="selection">
  <div class="container">
    <div class="selection-head">
      <p class="eyebrow eyebrow-light" data-reveal>Onze selectie</p>
      <h2 data-reveal style="--reveal-delay: 80ms">Wat u bij ons vindt</h2>
      <p class="selection-lead" data-reveal style="--reveal-delay: 160ms">
        Van vers versneden vlees tot krokant brood en huisbereide schotels:
        alles wordt bij ons met de hand gemaakt, dag na dag.
      </p>
    </div>

    <div class="tiles">
      {categories.map((c, i) => (
        <a
          href="/assortiment/"
          class="tile"
          data-reveal
          style={`--reveal-delay: ${(i % 3) * 90}ms`}
        >
          <img
            src={c.img}
            alt={c.title.replace(/&amp;/g, "&")}
            loading="lazy"
            style={c.pos ? `object-position: ${c.pos}` : undefined}
          />
          <span class="tile-shade"></span>
          <span class="tile-label" set:html={c.title} />
        </a>
      ))}
    </div>

    <div class="selection-cta">
      <a href="/assortiment/" class="btn btn-primary">Ontdek ons volledig assortiment</a>
    </div>
  </div>
</section>

<style>
  .selection {
    background: var(--color-charcoal);
    color: var(--color-cream);
  }

  .selection-head {
    max-width: 640px;
    margin: 0 auto 3rem;
    text-align: center;
  }

  .eyebrow-light {
    color: var(--color-gold-light);
    justify-content: center;
  }

  .selection h2 {
    margin-top: 0.75rem;
    color: var(--color-white);
    font-size: clamp(1.9rem, 3.5vw, 2.6rem);
    font-style: italic;
  }

  .selection-lead {
    margin-top: 1rem;
    color: var(--color-cream-soft);
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.85rem;
  }

  .tile {
    position: relative;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    border-radius: var(--radius);
    aspect-ratio: 4 / 5;
  }

  .tile img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.92) brightness(0.92);
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1), filter 0.5s ease;
  }

  .tile-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(15, 10, 8, 0.92) 0%,
      rgba(15, 10, 8, 0.15) 55%,
      rgba(15, 10, 8, 0.05) 100%
    );
    transition: background 0.4s ease;
  }

  .tile::after {
    content: "";
    position: absolute;
    inset: 0;
    border: 1px solid rgba(201, 187, 146, 0.35);
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
  }

  .tile:hover::after {
    opacity: 1;
  }

  .tile:hover img {
    transform: scale(1.08);
    filter: saturate(1.05) brightness(0.85);
  }

  .tile-label {
    position: relative;
    z-index: 1;
    padding: 1.1rem 1.2rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.1rem;
    color: var(--color-white);
    letter-spacing: 0.01em;
  }

  .selection-cta {
    display: flex;
    justify-content: center;
    margin-top: 3rem;
  }

  @media (max-width: 700px) {
    .tiles {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 460px) {
    .tiles {
      grid-template-columns: 1fr;
    }
    .tile {
      aspect-ratio: 4 / 3;
    }
  }
</style>
