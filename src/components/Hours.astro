---
import { openingHours, formatRanges, activeClosures } from "../data/business";

const closures = activeClosures();
---

<section id="openingsuren" class="hours">
  <div class="container hours-grid">
    <div class="hours-card" data-reveal>
      <div class="hours-head">
        <p class="eyebrow">Openingsuren</p>
        <span
          id="open-status"
          class="open-status"
          data-closures={JSON.stringify(closures.map(({ from, until }) => ({ from, until })))}
        >
          <span class="open-dot"></span>
          <span class="open-label">&nbsp;</span>
        </span>
      </div>
      <h2>Wanneer u bij ons terecht kan</h2>
      <ul>
        {openingHours.map((h, i) => (
          <li data-day-index={i} data-ranges={JSON.stringify(h.ranges)}>
            <span>{h.day}</span>
            <span class="time">{formatRanges(h.ranges)}</span>
          </li>
        ))}
      </ul>
      {closures.map((c) => (
        <p class="hours-closure" data-until={c.until}>
          <strong>{c.title}.</strong> {c.text}
        </p>
      ))}
      <p class="hours-note">* Feestdagen kunnen afwijken. Bel gerust om te bevestigen.</p>
    </div>

    <div class="hours-image" data-reveal style="--reveal-delay: 120ms">
      <img
        src="/images/gourmetschotel-sauzen-640.webp"
        srcset="/images/gourmetschotel-sauzen-640.webp 640w, /images/gourmetschotel-sauzen-1000.webp 1000w"
        sizes="(max-width: 900px) 100vw, 540px"
        width="640"
        height="480"
        alt="Steengrillschotel met koteletten, biefstuk, kip, worstjes, gepaneerde stukjes en kaas"
        loading="lazy"
      />
    </div>
  </div>
</section>

<style>
  .hours-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }

  .hours-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .open-status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-charcoal-soft);
  }

  .open-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-charcoal-soft);
    opacity: 0.4;
  }

  .open-status.is-open .open-dot {
    background: #4c7a4c;
    opacity: 1;
    box-shadow: 0 0 0 3px rgba(76, 122, 76, 0.18);
    animation: pulse-dot 2s ease-in-out infinite;
  }

  .open-status.is-open .open-label {
    color: #3f6b3f;
  }

  .open-status.is-closed .open-dot {
    background: var(--color-copper);
    opacity: 1;
  }

  .open-status.is-closed .open-label {
    color: var(--color-copper);
  }

  @keyframes pulse-dot {
    0%, 100% {
      box-shadow: 0 0 0 3px rgba(76, 122, 76, 0.18);
    }
    50% {
      box-shadow: 0 0 0 6px rgba(76, 122, 76, 0.08);
    }
  }

  .hours-card h2 {
    margin-top: 0.75rem;
    font-size: clamp(1.9rem, 3.2vw, 2.4rem);
    max-width: 14ch;
  }

  .hours-card ul {
    list-style: none;
    padding: 0;
    margin: 2.25rem 0 0;
  }

  .hours-card li {
    display: flex;
    justify-content: space-between;
    padding: 0.85rem 0.6rem;
    margin: 0 -0.6rem;
    border-bottom: 1px solid rgba(28, 23, 20, 0.1);
    font-size: 0.98rem;
    border-radius: var(--radius);
    transition: background 0.3s ease;
  }

  .hours-card li.is-today {
    background: rgba(170, 153, 99, 0.14);
    font-weight: 600;
  }

  .time {
    font-weight: 600;
    color: var(--color-copper);
  }

  .hours-closure {
    margin-top: 1.5rem;
    padding: 0.9rem 1rem;
    border-left: 3px solid var(--color-copper);
    background: rgba(164, 98, 47, 0.08);
    border-radius: var(--radius);
    font-size: 0.92rem;
    color: var(--color-charcoal);
  }

  .hours-note {
    margin-top: 1.25rem;
    font-size: 0.8rem;
    color: var(--color-charcoal-soft);
    font-style: italic;
  }

  .hours-image img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
  }

  @media (max-width: 900px) {
    .hours-grid {
      grid-template-columns: 1fr;
    }
    .hours-image {
      order: -1;
    }
  }
</style>

<script>
  const now = new Date();
  const dayIndex = (now.getDay() + 6) % 7;
  const minutesNow = now.getHours() * 60 + now.getMinutes();

  // Uren komen uit src/data/business.ts via data-ranges, Maandag=0 ... Zondag=6
  const toMinutes = (t: string) => {
    const [h, m] = t.split(":").map(Number);
    return h * 60 + m;
  };
  const todayLi = document.querySelector<HTMLElement>(`[data-day-index="${dayIndex}"]`);
  const todayRanges: number[][] = JSON.parse(todayLi?.dataset.ranges ?? "[]").map(
    ([open, close]: string[]) => [toMinutes(open), toMinutes(close)]
  );
  const statusEl = document.getElementById("open-status");
  const labelEl = statusEl?.querySelector(".open-label");

  // Verlof: tijdens de sluiting gesloten, en een sluiting die vandaag
  // begint, haalt het sluitingsuur van vandaag naar voren.
  const closures: { from: string; until: string }[] = JSON.parse(statusEl?.dataset.closures ?? "[]");
  const onLeave = closures.some((c) => now >= new Date(c.from) && now <= new Date(c.until));
  for (const c of closures) {
    const from = new Date(c.from);
    if (from.toDateString() !== now.toDateString()) continue;
    const cut = from.getHours() * 60 + from.getMinutes();
    todayRanges.forEach((r) => (r[1] = Math.min(r[1], cut)));
  }

  const closingRange = todayRanges.find(([start, end]) => minutesNow >= start && minutesNow < end);
  const isOpen = !onLeave && !!closingRange;

  if (statusEl && labelEl) {
    if (isOpen) {
      statusEl.classList.add("is-open");
      const closeH = Math.floor(closingRange![1] / 60);
      const closeM = String(closingRange![1] % 60).padStart(2, "0");
      labelEl.textContent = `Nu open tot ${closeH}:${closeM}`;
    } else {
      statusEl.classList.add("is-closed");
      labelEl.textContent = onLeave ? "Gesloten wegens verlof" : "Nu gesloten";
    }
  }

  document.querySelectorAll<HTMLElement>(".hours-closure[data-until]").forEach((el) => {
    if (now > new Date(el.dataset.until || "")) el.remove();
  });

  todayLi?.classList.add("is-today");
</script>
