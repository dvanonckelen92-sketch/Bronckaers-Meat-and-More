---
// Blok voor een lopende actie; de tekst komt via de slot.
// Na `until` verdwijnt het blok: bij de volgende build, en in de browser
// meteen via het script onderaan voor wie een oudere build te zien krijgt.
interface Props {
  id: string;
  until: string;
  eyebrow: string;
  title: string;
  img: { src: string; srcset?: string; width: number; height: number; alt: string };
  reverse?: boolean;
}

const { id, until, eyebrow, title, img, reverse = false } = Astro.props;

const expired = Date.now() > Date.parse(until);
---

{!expired && (
  <section id={id} class:list={["promo", { "promo-alt": reverse }]} data-until={until}>
    <div class="container promo-grid">
      <div class="promo-image" data-reveal>
        <img
          src={img.src}
          srcset={img.srcset}
          sizes={img.srcset ? "(max-width: 860px) 100vw, 520px" : undefined}
          width={img.width}
          height={img.height}
          alt={img.alt}
          loading="lazy"
        />
      </div>

      <div class="promo-content">
        <p class="eyebrow" data-reveal>{eyebrow}</p>
        <h2 data-reveal style="--reveal-delay: 80ms" set:html={title} />
        <div data-reveal style="--reveal-delay: 160ms">
          <slot />
        </div>
      </div>
    </div>
  </section>
)}

<style>
  .promo {
    background: var(--color-cream);
  }

  .promo-alt {
    background: var(--color-white);
  }

  .promo-grid {
    display: grid;
    grid-template-columns: minmax(0, 520px) 1fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  .promo-alt .promo-grid {
    grid-template-columns: 1fr minmax(0, 440px);
  }

  .promo-alt .promo-image {
    order: 1;
  }

  .promo-image img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    box-shadow: 0 18px 36px rgba(28, 23, 20, 0.18);
  }

  .promo-content h2 {
    margin-top: 0.75rem;
    font-size: clamp(1.9rem, 3.5vw, 2.6rem);
  }

  .promo-content :global(.promo-offer) {
    margin: 1.1rem 0 2rem;
    font-size: 1.15rem;
    color: var(--color-charcoal);
  }

  .promo-content :global(.promo-offer strong) {
    color: var(--color-copper-dark);
  }

  .promo-content :global(.promo-terms) {
    margin: -0.75rem 0 2rem;
    font-size: 0.85rem;
    color: var(--color-charcoal-soft);
  }

  .promo-content :global(.promo-terms a) {
    color: inherit;
    text-decoration: underline;
  }

  @media (max-width: 860px) {
    .promo-grid,
    .promo-alt .promo-grid {
      grid-template-columns: 1fr;
    }
    .promo-alt .promo-image {
      order: 0;
    }
    .promo-image {
      max-width: 520px;
    }
    .promo-alt .promo-image {
      max-width: 440px;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".promo[data-until]").forEach((promo) => {
    if (Date.now() > Date.parse(promo.dataset.until || "")) promo.remove();
  });
</script>
