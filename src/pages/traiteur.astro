---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Traiteur from "../components/Traiteur.astro";
import TraiteurSteps from "../components/TraiteurSteps.astro";
---

<Layout
  title="Traiteur & Catering | Bronckaers Meat and More"
  description="Traiteur en catering op maat voor elk feest: familiefeest, huwelijk, bedrijfsevent of receptie. Vraag vrijblijvend een offerte aan."
>
  <PageHero
    eyebrow="Traiteur & Catering"
    title="Wij verzorgen uw feest, van klein tot groots"
    lead="Familiefeest, huwelijk, bedrijfsevent of een gezellige babyborrel: we stellen samen met u een aanbod op maat op."
    image="https://images.unsplash.com/photo-1555244162-803834f70033?auto=format&fit=crop&w=1600&q=80"
  />
  <TraiteurSteps />
  <Traiteur variant="page" />
</Layout>
